# Development: where `npm run dev` forwards /api (default: the TAQAT staging server)
# API_PROXY_TARGET=http://ibram-backend.test

# Production build: full API address, without a trailing slash.
# Leave it empty only if the panel is served from the same domain as the API.
VITE_API_URL=

# Public website address (links in the terms & privacy page header/footer), e.g. https://ibram.ps
VITE_SITE_URL=
